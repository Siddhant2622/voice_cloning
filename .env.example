# VoiceGuard — Environment Variables
# Copy this file to .env and fill in your values

# ── Model ──────────────────────────────────────────────────────────────────
# Local path to trained CM checkpoint
# DETECT-2B-lite: WavLM + Wav2Vec2 + frame-level head (Resemble AI inspired)
CM_CHECKPOINT=models/cm_detect2b.pt

# Hugging Face Hub repo to pull checkpoint from on startup (optional)
# e.g. "your-username/voiceguard-cm"
HF_REPO_ID=

# Hugging Face token (required if HF_REPO_ID is set and repo is private)
HF_TOKEN=

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Auth ───────────────────────────────────────────────────────────────────
# Set to true to require API key authentication on all endpoints
API_KEY_REQUIRED=false

# Comma-separated list of valid API keys
# e.g. "key1,key2,key3"
API_KEYS=

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * for all (not recommended in prod)
CORS_ORIGINS=*

# ── Results ─────────────────────────────────────────────────────────────────
BENCHMARK_JSON=results/benchmark_asvspoof19.json
